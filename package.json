{
  "name": "@harryk-ds",
  "private": true,
  "version": "0.1.0",
  "description": "harryk-ds: 해리킴의 디자인 시스템",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter=\"@harryk-ds/ui\" --filter=\"@harryk-ds/motion\" dev",
    "build:ui": "pnpm --filter @harryk-ds/ui build",
    "build:motion": "pnpm --filter @harryk-ds/motion build",
    "dev:ui": "pnpm --filter @harryk-ds/ui dev",
    "dev:motion": "pnpm --filter @harryk-ds/motion dev",
    "storybook": "pnpm --filter @harryk-ds/storybook storybook",
    "build-storybook": "pnpm --filter @harryk-ds/storybook build-storybook",
    "chromatic": "pnpm --filter @harryk-ds/storybook chromatic",
    "chromatic:ci": "pnpm --filter @harryk-ds/storybook chromatic:ci",
    "clean": "pnpm -r exec rm -rf dist && rm -rf apps/storybook/storybook-static",
    "type-check": "pnpm -r type-check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "ai:init": "bash ./scripts/init-ai-launchers.sh",
    "postinstall": "pnpm ai:init"
  },
  "author": "harryk-im",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.6.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "motion",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/harryk-im/harryk-ds.git"
  },
  "bugs": {
    "url": "https://github.com/harryk-im/harryk-ds/issues"
  },
  "homepage": "https://github.com/harryk-im/harryk-ds#readme"
}
