{
  "name": "@harryk-ds",
  "private": true,
  "version": "0.1.0",
  "description": "harryk-ds: 해리킴의 디자인 시스템",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter=\"@harryk-ds/ui\" --filter=\"@harryk-motion\" dev",
    "build:ui": "pnpm --filter @harryk-ds/ui build",
    "build:motion": "pnpm --filter @harryk-motion build",
    "dev:ui": "pnpm --filter @harryk-ds/ui dev",
    "dev:motion": "pnpm --filter @harryk-motion dev",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "type-check": "pnpm -r type-check",
    "lint": "eslint packages --ext .ts,.tsx",
    "lint:fix": "eslint packages --ext .ts,.tsx --fix"
  },
  "author": "harryk-im",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.45.0"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "motion",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/harryk-im/harryk-ds.git"
  },
  "bugs": {
    "url": "https://github.com/harryk-im/harryk-ds/issues"
  },
  "homepage": "https://github.com/harryk-im/harryk-ds#readme"
}
