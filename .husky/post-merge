echo "🔄 git pull 또는 git merge를 감지했어요"

IS_AI_SYNCED=false

if git diff --name-only HEAD@{1} HEAD | grep -qE "package\.json|pnpm-lock\.yaml"; then
  echo "📦 패키지 변경사항을 감지했어요. pnpm install을 실행할게요..."

  if ! pnpm install; then
    echo "❌ pnpm install 실행 중 오류가 발생했어요"
    exit 1
  fi

  echo "✅ pnpm install이 성공적으로 완료되었어요!"
  IS_AI_SYNCED=true
else
  echo "✅ 패키지 변경사항을 감지하지 못했어요. pnpm install 실행을 건너뛸게요"
fi

# AI 페르소나 변경사항 확인
if [ "$IS_AI_SYNCED" = false ] && git diff --name-only HEAD@{1} HEAD | grep -qF ".ai/personas/"; then
  echo "🤖 AI 페르소나 변경사항을 감지했어요. 동기화를 진행할게요..."
  pnpm ai:sync
fi
