{
  "name": "@harryk-ds/ui",
  "version": "0.1.7",
  "description": "UI components for Harryk Design System",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/ui.css",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/global": {
      "types": "./dist/styles/foundation/global.css.d.ts",
      "import": "./dist/styles/foundation/global.css.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist/**/*.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system"
  ],
  "author": "harryk-im",
  "license": "MIT",
  "peerDependencies": {
    "@vanilla-extract/css": ">=1.13.0",
    "@vanilla-extract/recipes": ">=0.5.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryk-im/harryk-ds.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/harryk-im/harryk-ds/issues"
  },
  "homepage": "https://github.com/harryk-im/harryk-ds/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public"
  }
}
