{
  "name": "@harryk-ds/ui",
  "version": "0.0.0-20251101111514",
  "description": "UI components for Harryk Design System",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "style": "./dist/ui.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist/**/*.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system"
  ],
  "author": "harryk-im",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.17.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vanilla-extract/vite-plugin": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryk-im/harryk-ds.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/harryk-im/harryk-ds/issues"
  },
  "homepage": "https://github.com/harryk-im/harryk-ds/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public"
  }
}
