{
  "name": "@harryk-ds/storybook",
  "version": "0.1.0",
  "description": "Storybook for Harryk Design System",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "npx chromatic --only-changed --storybook-base-dir ../../ --storybook-config-dir .storybook",
    "chromatic:ci": "npx chromatic --exit-zero-on-changes --storybook-base-dir ../../ --storybook-config-dir .storybook"
  },
  "keywords": [
    "storybook",
    "design-system",
    "components"
  ],
  "author": "harryk-im",
  "license": "MIT",
  "dependencies": {
    "@harryk-ds/ui": "workspace:*",
    "@harryk-ds/motion": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vanilla-extract/vite-plugin": "^5.1.1",
    "chromatic": "^11.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.4.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
